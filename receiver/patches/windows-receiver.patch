+typedef struct {
+    int complete;
+    DNSServiceErrorType error;
+} registration_result_t;
+
+static void DNSSD_STDCALL
+registration_reply(DNSServiceRef service, DNSServiceFlags flags, DNSServiceErrorType error,
+                   const char *name, const char *type, const char *domain, void *context)
+{
+    registration_result_t *result = context;
+    result->error = error;
+    result->complete = 1;
+}
+
+static DNSServiceErrorType
+wait_for_registration(dnssd_t *dnssd, DNSServiceRef service, registration_result_t *result)
+{
+    int fd = dnssd->DNSServiceRefSockFD(service);
+    if (fd < 0) return kDNSServiceErr_BadReference;
+    ULONGLONG deadline = GetTickCount64() + 10000;
+    while (!result->complete) {
+        if (uxplay_stop_requested() || GetTickCount64() >= deadline) {
+            return kDNSServiceErr_Timeout;
+        }
+        fd_set descriptors;
+        FD_ZERO(&descriptors);
+        FD_SET((SOCKET) fd, &descriptors);
+        struct timeval timeout = {0, 100000};
+        int ready = select(fd + 1, &descriptors, NULL, NULL, &timeout);
+        if (ready == SOCKET_ERROR) return kDNSServiceErr_Unknown;
+        if (ready > 0) {
+            DNSServiceErrorType error = dnssd->DNSServiceProcessResult(service);
+            if (error != kDNSServiceErr_NoError) return error;
+        }
+    }
+    return result->error;
+}

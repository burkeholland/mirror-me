index 0000000..0aff02f
--- /dev/null
+++ b/src/WinPlay.Capture/DesktopPointer.cs
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+namespace WinPlay.Capture;
+
+internal enum PointerShapeType : uint
+{
+    Monochrome = 1,
+    Color = 2,
+    MaskedColor = 4,
+}
+
+internal readonly record struct PointerRegion(int X, int Y, int Width, int Height, int ShapeX, int ShapeY);
+
+// DXGI supplies the hardware pointer separately, in desktop pixels, with its
+// top-left position already adjusted for the hotspot.
+internal sealed class DesktopPointer
+{
+    private PointerShapeType _type;
+    private byte[] _shape = [];
+    private int _pitch;
+    private int _x;
+    private int _y;
+    private bool _visible;
+
+    public int Width { get; private set; }
+    public int Height { get; private set; }
+
+    public void UpdatePosition(long timestamp, int x, int y, bool visible)
+    {
+        if (timestamp == 0) return;
+        (_x, _y, _visible) = (x, y, visible);
+    }
+
+    // A shape that cannot be drawn hides the pointer until Windows supplies a
+    // valid one. A cursor glitch must never end the desktop share.
+    public bool SetShape(PointerShapeType type, int width, int height, int pitch, ReadOnlySpan<byte> shape)
+    {
+        long minimumPitch = type == PointerShapeType.Monochrome ? ((long)width + 7) / 8 : (long)width * 4;
+        if (type is not (PointerShapeType.Monochrome or PointerShapeType.Color or PointerShapeType.MaskedColor)
+            || width <= 0 || height <= 0 || pitch < minimumPitch || (long)pitch * height > shape.Length
+            || (type == PointerShapeType.Monochrome && (height & 1) != 0))
+        {
+            ClearShape();
+            return false;
+        }
+
+        _type = type;
+        Width = width;
+        // A monochrome DIB contains the AND mask followed by an equally tall XOR mask.
+        Height = type == PointerShapeType.Monochrome ? height / 2 : height;
+        _pitch = pitch;
+        _shape = shape[..checked(pitch * height)].ToArray();
+        return true;
+    }
+
+    public void ClearShape()
+    {
+        _shape = [];
+        Width = 0;
+        Height = 0;
+        _pitch = 0;
+    }
+
+    public PointerRegion GetRegion(int desktopWidth, int desktopHeight)
+    {
+        if (!_visible || _shape.Length == 0) return default;
+        int left = Math.Clamp(_x, 0, desktopWidth);
+        int top = Math.Clamp(_y, 0, desktopHeight);
+        int right = (int)Math.Clamp((long)_x + Width, 0, desktopWidth);
+        int bottom = (int)Math.Clamp((long)_y + Height, 0, desktopHeight);
+        if (right <= left || bottom <= top) return default;
+        return new(left, top, right - left, bottom - top, left - _x, top - _y);
+    }
+
+    // The destination is only the clipped cursor rectangle, not a full desktop
+    // readback. Its row stride can include driver padding.
+    public void Composite(Span<byte> bgra, int rowPitch, PointerRegion region)
+    {
+        if (region.Width <= 0 || region.Height <= 0) return;
+        if (region.ShapeX < 0 || region.ShapeY < 0 || (long)region.ShapeX + region.Width > Width
+            || (long)region.ShapeY + region.Height > Height || rowPitch < (long)region.Width * 4
+            || bgra.Length < (long)(region.Height - 1) * rowPitch + (long)region.Width * 4)
+            throw new ArgumentException("Invalid desktop pointer composition region.");
+
+        for (int y = 0; y < region.Height; y++)
+        for (int x = 0; x < region.Width; x++)
+        {
+            int sx = region.ShapeX + x, sy = region.ShapeY + y;
+            int destination = y * rowPitch + x * 4;
+            if (_type == PointerShapeType.Monochrome)
+            {
+                int index = sy * _pitch + sx / 8;
+                int bit = 0x80 >> (sx & 7);
+                int andMask = (_shape[index] & bit) != 0 ? 255 : 0;
+                int xorMask = (_shape[index + Height * _pitch] & bit) != 0 ? 255 : 0;
+                for (int channel = 0; channel < 3; channel++)
+                    bgra[destination + channel] = (byte)((bgra[destination + channel] & andMask) ^ xorMask);
+            }
+            else
+            {
+                int source = sy * _pitch + sx * 4;
+                int alpha = _shape[source + 3];
+                for (int channel = 0; channel < 3; channel++)
+                {
+                    int foreground = _shape[source + channel], background = bgra[destination + channel];
+                    // Masked-color alpha should be 0 (replace) or 0xFF (XOR); treat any nonzero mask as XOR.
+                    bgra[destination + channel] = _type == PointerShapeType.Color
+                        ? (byte)((foreground * alpha + background * (255 - alpha) + 127) / 255)
+                        : (byte)(alpha != 0 ? background ^ foreground : foreground);
+                }
+            }
+            bgra[destination + 3] = 255;
+        }
+    }
+}

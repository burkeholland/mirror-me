+++ b/tests/WinPlay.Core.Tests/DesktopPointerTests.cs
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+using WinPlay.Capture;
+using Xunit;
+
+namespace WinPlay.Core.Tests;
+
+public class DesktopPointerTests
+{
+    private static DesktopPointer ColorPointer(int width = 1, int height = 1)
+    {
+        var pointer = new DesktopPointer();
+        byte[] shape = new byte[width * height * 4];
+        for (int i = 0; i < width * height; i++)
+        {
+            shape[i * 4] = (byte)(i + 1);
+            shape[i * 4 + 3] = 255;
+        }
+        pointer.SetShape(PointerShapeType.Color, width, height, width * 4, shape);
+        pointer.UpdatePosition(1, 0, 0, true);
+        return pointer;
+    }
+
+    [Fact]
+    public void ColorPointer_PreservesTransparencyAndBlendsEdges()
+    {
+        var pointer = new DesktopPointer();
+        pointer.SetShape(PointerShapeType.Color, 3, 1, 16,
+            [200, 100, 50, 0, 200, 100, 50, 255, 200, 100, 50, 128, 99, 99, 99, 99]);
+        pointer.UpdatePosition(1, 0, 0, true);
+        byte[] desktop = [20, 40, 60, 255, 20, 40, 60, 255, 20, 40, 60, 255, 77, 77, 77, 77];
+        pointer.Composite(desktop, 16, pointer.GetRegion(3, 1));
+        Assert.Equal(new byte[] { 20, 40, 60, 255, 200, 100, 50, 255, 110, 70, 55, 255, 77, 77, 77, 77 }, desktop);
+    }
+
+    [Fact]
+    public void MonochromePointer_AppliesAllAndXorCasesWithSeparateMaskRows()
+    {
+        var pointer = new DesktopPointer();
+        pointer.SetShape(PointerShapeType.Monochrome, 10, 4, 2, [0x30, 0x40, 0xff, 0xc0, 0x50, 0x80, 0, 0]);
+        pointer.UpdatePosition(1, 0, 0, true);
+        Assert.Equal(2, pointer.Height);
+        byte[] desktop = Enumerable.Repeat((byte)0x55, 88).ToArray();
+        pointer.Composite(desktop, 44, pointer.GetRegion(10, 2));
+        Assert.Equal(0, desktop[0]);       // AND=0, XOR=0: black
+        Assert.Equal(255, desktop[4]);     // AND=0, XOR=1: white
+        Assert.Equal(0x55, desktop[8]);    // AND=1, XOR=0: unchanged
+        Assert.Equal(0xaa, desktop[12]);   // AND=1, XOR=1: inverted background
+        Assert.Equal(255, desktop[32]);    // pixel 8 uses the next mask byte
+        Assert.Equal(0x55, desktop[36]);
+        Assert.Equal(0x55, desktop[44]);   // second mask row is not the XOR plane
+        Assert.Equal(0x55, desktop[80]);
+        Assert.All(desktop[40..44], b => Assert.Equal(0x55, b));
+        Assert.All(desktop[84..88], b => Assert.Equal(0x55, b));
+    }
+
+    [Fact]
+    public void MaskedColorPointer_ReplacesOrXorsInsteadOfAlphaBlending()
+    {
+        var pointer = new DesktopPointer();
+        pointer.SetShape(PointerShapeType.MaskedColor, 2, 1, 8, [0x10, 0x20, 0x30, 0, 1, 0x80, 0xff, 255]);
+        pointer.UpdatePosition(1, 0, 0, true);
+        byte[] desktop = [0xaa, 0xbb, 0xcc, 255, 0xaa, 0xbb, 0xcc, 255];
+        pointer.Composite(desktop, 8, pointer.GetRegion(2, 1));
+        Assert.Equal(new byte[] { 0x10, 0x20, 0x30, 255, 0xab, 0x3b, 0x33, 255 }, desktop);
+    }
+
+    [Theory]
+    [InlineData(-2, -1, 0, 0, 2, 2, 2, 1)]
+    [InlineData(7, 7, 7, 7, 1, 1, 0, 0)]
+    [InlineData(-2, 7, 0, 7, 2, 1, 2, 0)]
+    [InlineData(7, -1, 7, 0, 1, 2, 0, 1)]
+    public void PointerClipsAllDesktopEdges(int x, int y, int left, int top, int width, int height, int sx, int sy)
+    {
+        var pointer = ColorPointer(4, 3);
+        pointer.UpdatePosition(2, x, y, true);
+        var region = pointer.GetRegion(8, 8);
+        Assert.Equal(new PointerRegion(left, top, width, height, sx, sy), region);
+        byte[] clipped = new byte[width * height * 4];
+        pointer.Composite(clipped, width * 4, region);
+        for (int row = 0; row < height; row++)
+        for (int column = 0; column < width; column++)
+            Assert.Equal((byte)((sy + row) * 4 + sx + column + 1), clipped[(row * width + column) * 4]);
+    }
+
+    [Theory]
+    [InlineData(-4, 0)]
+    [InlineData(8, 0)]
+    [InlineData(0, -3)]
+    [InlineData(0, 8)]
+    [InlineData(int.MinValue, int.MinValue)]
+    [InlineData(int.MaxValue, int.MaxValue)]
+    public void PointerOutsideCapturedMonitorDoesNotDraw(int x, int y)
+    {
+        var pointer = ColorPointer(4, 3);
+        pointer.UpdatePosition(2, x, y, true);
+        Assert.Equal(default, pointer.GetRegion(8, 8));
+    }
+
+    [Fact]
+    public void NoMouseUpdateKeepsShapePositionAndVisibility()
+    {
+        var pointer = ColorPointer(4, 3);
+        pointer.UpdatePosition(2, 2, 3, true);
+        pointer.UpdatePosition(0, 0, 0, false);
+        Assert.Equal(new PointerRegion(2, 3, 4, 3, 0, 0), pointer.GetRegion(20, 20));
+        pointer.UpdatePosition(3, 2, 3, false);
+        Assert.Equal(default, pointer.GetRegion(20, 20)); // hidden or already embedded by Windows
+        pointer.UpdatePosition(4, 4, 5, true);
+        Assert.Equal(new PointerRegion(4, 5, 4, 3, 0, 0), pointer.GetRegion(20, 20));
+    }
+
+    [Fact]
+    public void EnlargedPointerDrawsItsEntireShape()
+    {
+        var pointer = ColorPointer(128, 128);
+        var region = pointer.GetRegion(1920, 1080);
+        Assert.Equal(128, region.Width);
+        Assert.Equal(128, region.Height);
+        byte[] desktop = new byte[128 * 128 * 4];
+        pointer.Composite(desktop, 128 * 4, region);
+        Assert.Equal(255, desktop[^1]);
+        Assert.Equal(255, desktop[^8]);
+    }
+
+    [Fact]
+    public void PointerMovementAndHideRecomposeOnTheUnmodifiedDesktop()
+    {
+        var pointer = ColorPointer();
+        byte[] original = [20, 40, 60, 255, 20, 40, 60, 255];
+        byte[] Render()
+        {
+            byte[] output = (byte[])original.Clone();
+            var region = pointer.GetRegion(2, 1);
+            if (region.Width > 0)
+                pointer.Composite(output.AsSpan(region.X * 4), 8, region);
+            return output;
+        }
+        Assert.Equal(1, Render()[0]);
+        pointer.UpdatePosition(2, 1, 0, true); // pointer-only update, no new desktop pixels
+        var moved = Render();
+        Assert.Equal(original[..4], moved[..4]);
+        Assert.Equal(1, moved[4]);
+        pointer.UpdatePosition(3, 1, 0, false);
+        Assert.Equal(original, Render());
+    }
+
+    [Theory]
+    [InlineData(0, 1, 1, 4, 4)]
+    [InlineData(2, 0, 1, 4, 4)]
+    [InlineData(2, 2, 1, 4, 8)]
+    [InlineData(2, 1, 2, 4, 4)]
+    [InlineData(1, 8, 3, 1, 3)]
+    [InlineData(1, 9, 2, 1, 2)]
+    public void InvalidShapesHideThePointerInsteadOfFailing(uint type, int width, int height, int pitch, int length)
+    {
+        var pointer = ColorPointer();
+        Assert.False(pointer.SetShape((PointerShapeType)type, width, height, pitch, new byte[length]));
+        Assert.Equal(default, pointer.GetRegion(8, 8));
+        Assert.Equal(0, pointer.Width);
+        Assert.Equal(0, pointer.Height);
+    }
+
+    [Fact]
+    public void VisiblePointerWithoutShapeDrawsNothing()
+    {
+        var pointer = new DesktopPointer();
+        pointer.UpdatePosition(1, 0, 0, true);
+        byte[] desktop = [20, 40, 60, 255];
+        var region = pointer.GetRegion(1, 1);
+        Assert.Equal(default, region);
+        pointer.Composite(desktop, 4, region);
+        Assert.Equal(new byte[] { 20, 40, 60, 255 }, desktop);
+    }
+
+    [Fact]
+    public void ValidShapeAfterInvalidShapeDrawsAgain()
+    {
+        var pointer = ColorPointer();
+        Assert.False(pointer.SetShape((PointerShapeType)3, 1, 1, 4, new byte[4]));
+        Assert.True(pointer.SetShape(PointerShapeType.Color, 1, 1, 4, [9, 8, 7, 255]));
+        byte[] desktop = [0, 0, 0, 255];
+        pointer.Composite(desktop, 4, pointer.GetRegion(1, 1));
+        Assert.Equal(new byte[] { 9, 8, 7, 255 }, desktop);
+    }
+
+    [Fact]
+    public void MaskedColorPointerTreatsNonBinaryMaskAsXor()
+    {
+        var pointer = new DesktopPointer();
+        Assert.True(pointer.SetShape(PointerShapeType.MaskedColor, 1, 1, 4, [0x0f, 0xf0, 0xff, 0x80]));
+        pointer.UpdatePosition(1, 0, 0, true);
+        byte[] desktop = [0xaa, 0xbb, 0xcc, 255];
+        pointer.Composite(desktop, 4, pointer.GetRegion(1, 1));
+        Assert.Equal(new byte[] { 0xa5, 0x4b, 0x33, 255 }, desktop);
+    }
+}

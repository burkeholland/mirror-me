@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using WinPlay.Core.Hap;
+using WinPlay.Core.Mirror;
+using WinPlay.Core.Plist;
+using WinPlay.Core.Rtsp;
+using Xunit;
+
+namespace WinPlay.Core.Tests;
+
+public class ReceiverPairingTests
+{
+    [Fact]
+    public async Task BeginAsync_UsesAirPlayHttpPairingHeaders()
+    {
+        using var listener = new TcpListener(IPAddress.Loopback, 0);
+        listener.Start();
+        int port = ((IPEndPoint)listener.LocalEndpoint).Port;
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(3));
+
+        Task begin = ReceiverPairing.BeginAsync(IPAddress.Loopback, port, timeout.Token);
+        using TcpClient receiver = await listener.AcceptTcpClientAsync(timeout.Token);
+        NetworkStream stream = receiver.GetStream();
+        var request = new List<byte>();
+        byte[] buffer = new byte[256];
+        while (!Encoding.ASCII.GetString(request.ToArray()).Contains("\r\n\r\n", StringComparison.Ordinal))
+        {
+            int read = await stream.ReadAsync(buffer, timeout.Token);
+            request.AddRange(buffer.AsSpan(0, read).ToArray());
+        }
+
+        byte[] forbidden = Encoding.ASCII.GetBytes(
+            "HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n\r\n");
+        await stream.WriteAsync(forbidden, timeout.Token);
+        await Assert.ThrowsAsync<RtspException>(() => begin);
+
+        string wire = Encoding.ASCII.GetString(request.ToArray());
+        Assert.StartsWith("POST /pair-pin-start HTTP/1.1\r\n", wire);
+        Assert.Contains("User-Agent: AirPlay/320.20\r\n", wire);
+        Assert.Contains("Connection: keep-alive\r\n", wire);
+        Assert.Contains("Content-Type: application/octet-stream\r\n", wire);
+        Assert.Contains("X-Apple-HKP: 3\r\n", wire);
+        Assert.DoesNotContain("CSeq:", wire);
+        Assert.DoesNotContain("DACP-ID:", wire);
+    }
+
+    [Fact]
+    public async Task BeginAsync_ReachesPinEntry_AndKeepsPersistentModeForProof()
+    {
+        using var listener = new TcpListener(IPAddress.Loopback, 0);
+        listener.Start();
+        int port = ((IPEndPoint)listener.LocalEndpoint).Port;
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+        var ct = timeout.Token;
+
+        var begin = ReceiverPairing.BeginAsync(IPAddress.Loopback, port, ct);
+        using TcpClient receiver = await listener.AcceptTcpClientAsync(ct);
+        NetworkStream stream = receiver.GetStream();
+        var start = await ReadRequestAsync(stream, ct);
+        AssertPairingHeaders(start.Headers, "/pair-pin-start", "3");
+        Assert.Empty(start.Body);
+        await ReplyAsync(stream, [], ct);
+
+        var setup = await ReadRequestAsync(stream, ct);
+        AssertPairingHeaders(setup.Headers, "/pair-setup", "3");
+        var m1 = Tlv8.Decode(setup.Body);
+        Assert.Equal(new byte[] { 1 }, Tlv8.Find(m1, TlvType.State));
+        Assert.Equal(new byte[] { 0 }, Tlv8.Find(m1, TlvType.Method));
+        Assert.Null(Tlv8.Find(m1, TlvType.Flags));
+        await ReplyAsync(stream, Tlv8.Encode(
+        [
+            (TlvType.State, [2]),
+            (TlvType.Salt, new byte[16]),
+            (TlvType.PublicKey, [2]),
+        ]), ct);
+
+        // Begin returns only once the helper can emit "pairing" and wait for a PIN.
+        using var pairing = await begin;
+        var finish = pairing.FinishAsync("1234", ct);
+        var proof = await ReadRequestAsync(stream, ct);
+        AssertPairingHeaders(proof.Headers, "/pair-setup", "3");
+        var m3 = Tlv8.Decode(proof.Body);
+        Assert.Equal(new byte[] { 3 }, Tlv8.Find(m3, TlvType.State));
+        Assert.NotNull(Tlv8.Find(m3, TlvType.Proof));
+        await ReplyAsync(stream, Tlv8.Encode(
+        [
+            (TlvType.State, [4]),
+            (TlvType.Error, [2]),
+        ]), ct);
+        await Assert.ThrowsAsync<HapPairingException>(() => finish);
+    }
+
+    [Theory]
+    [InlineData(false, "4", "/pair-setup")]
+    [InlineData(true, "3", "/pair-verify")]
+    public async Task ConnectAsync_SelectsModeForTransientOrSavedCredentials(
+        bool saved, string hkp, string endpoint)
+    {
+        using var listener = new TcpListener(IPAddress.Loopback, 0);
+        listener.Start();
+        int port = ((IPEndPoint)listener.LocalEndpoint).Port;
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+        var ct = timeout.Token;
+        var credentials = saved ? new HapPairingCredentials
+        {
+            ReceiverPublicKey = new byte[32],
+            ReceiverId = "receiver"u8.ToArray(),
+            OurPrivateKey = new byte[32],
+            OurId = "sender"u8.ToArray(),
+        } : null;
+
+        var connect = MirrorSession.ConnectAsync(IPAddress.Loopback, port, credentials,
+            ct: ct, withAudio: false);
+        using TcpClient receiver = await listener.AcceptTcpClientAsync(ct);
+        NetworkStream stream = receiver.GetStream();
+        var info = await ReadRequestAsync(stream, ct);
+        Assert.StartsWith("GET /info RTSP/1.0\r\n", info.Headers);
+        await ReplyAsync(stream, BinaryPlist.Write(new Dictionary<string, object?>()), ct);
+
+        if (!saved)
+        {
+            var start = await ReadRequestAsync(stream, ct);
+            AssertPairingHeaders(start.Headers, "/pair-pin-start", hkp);
+            await ReplyAsync(stream, [], ct);
+        }
+
+        var request = await ReadRequestAsync(stream, ct);
+        AssertPairingHeaders(request.Headers, endpoint, hkp);
+        var m1 = Tlv8.Decode(request.Body);
+        Assert.Equal(new byte[] { 1 }, Tlv8.Find(m1, TlvType.State));
+        if (saved)
+            Assert.Null(Tlv8.Find(m1, TlvType.Flags));
+        else
+            Assert.Equal(new byte[] { 0x10 }, Tlv8.Find(m1, TlvType.Flags));
+        await stream.WriteAsync(Encoding.ASCII.GetBytes(
+            "HTTP/1.1 470 Connection Authorization Required\r\nContent-Length: 0\r\n\r\n"), ct);
+
+        if (saved)
+            Assert.Equal(470, (await Assert.ThrowsAsync<RtspException>(() => connect)).StatusCode);
+        else
+        {
+            var error = await Assert.ThrowsAsync<PairingRequiredException>(() => connect);
+            Assert.Equal(470, Assert.IsType<RtspException>(error.InnerException).StatusCode);
+        }
+    }
+
+    private static void AssertPairingHeaders(string headers, string endpoint, string hkp)
+    {
+        Assert.StartsWith($"POST {endpoint} HTTP/1.1\r\n", headers);
+        Assert.Contains($"X-Apple-HKP: {hkp}\r\n", headers);
+        Assert.Contains("User-Agent: AirPlay/320.20\r\n", headers);
+        Assert.Contains("Connection: keep-alive\r\n", headers);
+        Assert.Contains("Content-Type: application/octet-stream\r\n", headers);
+        Assert.DoesNotContain("CSeq:", headers);
+        Assert.DoesNotContain("DACP-ID:", headers);
+    }
+
+    private static async Task<(string Headers, byte[] Body)> ReadRequestAsync(
+        NetworkStream stream, CancellationToken ct)
+    {
+        var header = new List<byte>();
+        byte[] next = new byte[1];
+        while (true)
+        {
+            await stream.ReadExactlyAsync(next, ct);
+            header.Add(next[0]);
+            if (header.Count >= 4 && header.TakeLast(4).SequenceEqual("\r\n\r\n"u8.ToArray()))
+                break;
+            Assert.True(header.Count < 8192, "Pairing request headers are too large.");
+        }
+        string headers = Encoding.ASCII.GetString(header.ToArray());
+        string? length = headers.Split("\r\n").FirstOrDefault(
+            line => line.StartsWith("Content-Length:", StringComparison.OrdinalIgnoreCase));
+        byte[] body = new byte[length is null ? 0 : int.Parse(length.Split(':')[1])];
+        await stream.ReadExactlyAsync(body, ct);
+        return (headers, body);
+    }
+
+    private static async Task ReplyAsync(NetworkStream stream, byte[] body, CancellationToken ct)
+    {
+        byte[] headers = Encoding.ASCII.GetBytes(
+            $"HTTP/1.1 200 OK\r\nContent-Length: {body.Length}\r\n\r\n");
+        await stream.WriteAsync(headers, ct);
+        await stream.WriteAsync(body, ct);
+    }
+}

+    private static IDXGIAdapter1 FindPrimaryAdapter(IDXGIFactory1 factory, out uint outputIndex)
+    {
+        for (uint i = 0; factory.EnumAdapters1(i, out IDXGIAdapter1 adapter).Success; i++)
+        {
+            bool selected = false;
+            try
+            {
+                for (uint j = 0; adapter.EnumOutputs(j, out IDXGIOutput output).Success; j++)
+                {
+                    using (output)
+                    {
+                        var desc = output.Description;
+                        if (desc.AttachedToDesktop && desc.DesktopCoordinates.Left == 0 && desc.DesktopCoordinates.Top == 0)
+                        {
+                            if (desc.Rotation is not ModeRotation.Identity and not ModeRotation.Unspecified)
+                                throw new NotSupportedException("Rotated primary displays are not supported yet.");
+                            outputIndex = j;
+                            selected = true;
+                            return adapter;
+                        }
+                    }
+                }
+            }
+            finally { if (!selected) adapter.Dispose(); }
+        }
+        throw new InvalidOperationException("No primary desktop display is available for capture.");
+    }
